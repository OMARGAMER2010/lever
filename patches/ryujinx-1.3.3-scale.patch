diff --git a/src/Ryujinx.Common/FrameTimeRecorder.cs b/src/Ryujinx.Common/FrameTimeRecorder.cs
new file mode 100644
--- /dev/null
+++ b/src/Ryujinx.Common/FrameTimeRecorder.cs
@@ -0,0 +1,87 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Globalization;
+using System.IO;
+using System.Text;
+using System.Threading;
+
+namespace Ryujinx.Common
+{
+    // Instrumentación de laboratorio, inactiva sin una ruta explícita. Las escrituras se hacen
+    // por lotes fuera del hilo de render para no convertir la medición en una fuente de tirones.
+    public sealed class FrameTimeRecorder
+    {
+        private readonly object _sampleLock = new();
+        private readonly object _writeLock = new();
+        private readonly string _path;
+        private readonly long _start = Stopwatch.GetTimestamp();
+        private readonly Timer _timer;
+        private List<(double Time, double Milliseconds)> _pending = new(512);
+        private long _previous;
+        private volatile bool _failed;
+
+        private FrameTimeRecorder(string path)
+        {
+            _path = path;
+            File.WriteAllText(path, $"# started_utc={DateTime.UtcNow:O}\nelapsed_s,frame_ms\n");
+            _timer = new Timer(_ => Flush(), null, 5000, 5000);
+            AppDomain.CurrentDomain.ProcessExit += (_, _) => Flush();
+        }
+
+        public static FrameTimeRecorder FromEnvironment(string source)
+        {
+            string prefix = Environment.GetEnvironmentVariable("LEVER_FRAME_LOG");
+            if (string.IsNullOrWhiteSpace(prefix) || !Path.IsPathRooted(prefix)) return null;
+            try { return new FrameTimeRecorder(prefix + "." + source + ".csv"); }
+            catch (Exception error) when (error is IOException or UnauthorizedAccessException)
+            {
+                Console.Error.WriteLine($"Lever frame recorder: {error.Message}");
+                return null;
+            }
+        }
+
+        public void Record()
+        {
+            if (_failed) return;
+            long now = Stopwatch.GetTimestamp();
+            lock (_sampleLock)
+            {
+                if (_previous != 0 && _pending.Count < 36000)
+                {
+                    _pending.Add(((double)(now - _start) / Stopwatch.Frequency,
+                        1000.0 * (now - _previous) / Stopwatch.Frequency));
+                }
+                _previous = now;
+            }
+        }
+
+        private void Flush()
+        {
+            lock (_writeLock)
+            {
+                if (_failed) return;
+                List<(double Time, double Milliseconds)> samples;
+                lock (_sampleLock)
+                {
+                    samples = _pending;
+                    _pending = new(512);
+                }
+                if (samples.Count == 0) return;
+                StringBuilder output = new(samples.Count * 24);
+                foreach (var sample in samples)
+                {
+                    output.Append(sample.Time.ToString("F6", CultureInfo.InvariantCulture)).Append(',')
+                        .Append(sample.Milliseconds.ToString("F6", CultureInfo.InvariantCulture)).Append('\n');
+                }
+                try { File.AppendAllText(_path, output.ToString()); }
+                catch (Exception error) when (error is IOException or UnauthorizedAccessException)
+                {
+                    _failed = true;
+                    _timer.Dispose();
+                    Console.Error.WriteLine($"Lever frame recorder: {error.Message}");
+                }
+            }
+        }
+    }
+}
diff --git a/src/Ryujinx.Graphics.Gpu/Image/TextureScaleGeometry.cs b/src/Ryujinx.Graphics.Gpu/Image/TextureScaleGeometry.cs
new file mode 100644
--- /dev/null
+++ b/src/Ryujinx.Graphics.Gpu/Image/TextureScaleGeometry.cs
@@ -0,0 +1,20 @@
+using System;
+
+namespace Ryujinx.Graphics.Gpu.Image
+{
+    public static class TextureScaleGeometry
+    {
+        public static bool SupportsMipLevels(int width, int height, int levels, float scale)
+        {
+            if (scale >= 1f || levels <= 1)
+            {
+                return true;
+            }
+
+            int scaledWidth = Math.Max(1, (int)MathF.Ceiling(width * scale));
+            int scaledHeight = Math.Max(1, (int)MathF.Ceiling(height * scale));
+            int availableLevels = 1 + System.Numerics.BitOperations.Log2((uint)Math.Max(scaledWidth, scaledHeight));
+            return levels <= availableLevels;
+        }
+    }
+}
